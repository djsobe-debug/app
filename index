          { id: 'w2_e2', name: 'Махи стоячи в сторони гантелями', rest: 90, note: 'Орієнтир з док: 6 кг', weeks: ['3/15','3/15','3/15','3/15','3/15','4/15','4/15','4/15'] },
          { id: 'w2_e3', name: 'Розведення назад в блочному', rest: 90, note: 'Орієнтир з док: 40 кг', weeks: ['3/15','3/15','3/15','3/15','3/15','4/15','4/15','4/15'] },
          { id: 'w2_e4', name: 'Жим ногами платфори', rest: 90, note: 'Орієнтир з док: 80 кг', weeks: ['*3/10','*3/10','*3/10','*3/10','*3/10','*4/10','*4/10','*4/10'] },
          { id: 'w2_e5', name: 'Розгинання ніг сидячи', rest: 90, note: 'Орієнтир з док: 30 кг', weeks: ['3/15','3/15','3/15','3/15','3/15','4/15','4/15','4/15'] },
          { id: 'w2_e6', name: 'Згинання ніг сидячи', rest: 90, note: 'Орієнтир з док: 30 кг', weeks: ['3/15','3/15','3/15','3/15','3/15','4/15','4/15','4/15'] },
          { id: 'w2_e7', name: 'Осел', rest: 60, note: '', weeks: ['3/15','3/15','3/15','3/20','3/20','3/20','4/15','4/15'] }
        ]
      },
      {
        id: 'w3',
        num: 3,
        title: 'Біцепс, тріцепс',
