<!DOCTYPE html>
<html lang="uk" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Програма тренувань • 8 тижнів</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    };
  </script>
  <style>
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #09090b;
      color: #f4f4f5;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior-y: contain;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type="number"] { -moz-appearance: textfield; }
    .safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0px); }
    .safe-top { padding-top: env(safe-area-inset-top, 0px); }
  </style>
</head>
<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased selection:bg-emerald-500/30">

  <!-- Sticky Top Header -->
  <header class="sticky top-0 z-30 border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md safe-top">
    <div class="mx-auto max-w-2xl px-4 py-3">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0">
          <h1 class="truncate text-base font-bold tracking-tight text-white sm:text-lg">Періодизація • 8 тижнів</h1>
          <p id="header-subtitle" class="truncate text-xs text-zinc-400">Тиждень 1 • Тренування №1</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button id="btn-auto-timer" type="button" class="flex items-center gap-1.5 rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-xs font-medium text-zinc-300 transition active:scale-95">
            <span id="auto-timer-dot" class="h-2 w-2 rounded-full bg-emerald-400"></span>
            <span>Автотаймер</span>
          </button>
          <span id="workout-progress-badge" class="rounded-full bg-emerald-500/15 px-2.5 py-1 text-xs font-semibold text-emerald-400 border border-emerald-500/25">
            0/7
          </span>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="mt-2.5 h-1.5 w-full overflow-hidden rounded-full bg-zinc-800">
        <div id="workout-progress-bar" class="h-full rounded-full bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="mx-auto max-w-2xl px-3.5 pb-36 pt-3 sm:px-4">

    <!-- VIEW: WORKOUT -->
    <section id="view-workout" class="space-y-3.5">
      <!-- Week Selector -->
      <div>
        <div class="mb-1.5 flex items-center justify-between px-0.5">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400">Тиждень програми</span>
          <span id="week-completion-text" class="text-[11px] text-zinc-400"></span>
        </div>
        <div id="week-pills" class="flex gap-2 overflow-x-auto no-scrollbar pb-1"></div>
      </div>

      <!-- Workout Day Selector -->
      <div>
        <div class="mb-1.5 flex items-center justify-between px-0.5">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400">Тренування (до 80 хв)</span>
        </div>
        <div id="workout-pills" class="flex gap-2 overflow-x-auto no-scrollbar pb-1"></div>
      </div>

      <!-- Active Workout Banner -->
      <div id="workout-banner" class="flex items-center justify-between rounded-2xl border border-zinc-800 bg-zinc-900/70 px-4 py-3">
        <div>
          <h2 id="active-workout-title" class="text-sm font-bold text-white sm:text-base"></h2>
          <p id="active-workout-meta" class="text-xs text-zinc-400"></p>
        </div>
        <button id="btn-quick-copy-prev" type="button" class="rounded-xl border border-zinc-700 bg-zinc-800/80 px-3 py-2 text-xs font-medium text-zinc-200 transition hover:bg-zinc-700 active:scale-95">
          Підтягнути мин. тиж.
        </button>
      </div>

      <!-- Exercise List -->
      <div id="exercise-list" class="space-y-3"></div>
    </section>

    <!-- VIEW: PROGRESS -->
    <section id="view-progress" class="hidden space-y-4">
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-4 space-y-3">
        <h2 class="text-base font-bold text-white">Динаміка прогресу</h2>
        <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
          <div>
            <label for="progress-workout-select" class="mb-1 block text-xs font-medium text-zinc-400">Тренування</label>
            <select id="progress-workout-select" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3 py-2.5 text-sm text-white focus:border-emerald-500 focus:outline-none"></select>
          </div>
          <div>
            <label for="progress-exercise-select" class="mb-1 block text-xs font-medium text-zinc-400">Вправа</label>
            <select id="progress-exercise-select" class="w-full rounded-xl border border-zinc-700 bg-zinc-950 px-3 py-2.5 text-sm text-white focus:border-emerald-500 focus:outline-none"></select>
          </div>
        </div>
      </div>

      <!-- KPI Cards -->
      <div class="grid grid-cols-3 gap-2.5">
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-3 text-center">
          <div class="text-[11px] font-medium text-zinc-400">Макс. вага</div>
          <div id="kpi-max-weight" class="mt-1 text-lg font-bold text-emerald-400">0 кг</div>
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-3 text-center">
          <div class="text-[11px] font-medium text-zinc-400">Тоннаж (макс)</div>
          <div id="kpi-max-volume" class="mt-1 text-lg font-bold text-amber-400">0 кг</div>
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-3 text-center">
          <div class="text-[11px] font-medium text-zinc-400">Вик. підходів</div>
          <div id="kpi-total-sets" class="mt-1 text-lg font-bold text-white">0</div>
        </div>
      </div>

      <!-- Chart -->
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-4">
        <div class="mb-2 flex items-center justify-between">
          <span class="text-xs font-semibold text-zinc-300">Робоча вага по тижнях (кг)</span>
          <span id="chart-exercise-label" class="text-xs text-zinc-400 truncate max-w-[180px]"></span>
        </div>
        <div class="relative h-72">
          <canvas id="progress-chart"></canvas>
        </div>
      </div>
    </section>

    <!-- VIEW: DATA / BACKUP -->
    <section id="view-data" class="hidden space-y-4">
      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-4 space-y-2">
        <h2 class="text-base font-bold text-white">Збереження та резервна копія</h2>
        <p class="text-xs leading-relaxed text-zinc-400">
          Усі записи автоматично зберігаються локально у пам'яті твого браузера на iPhone. Щоб додати сторінку на головний екран iPhone: у Safari натисни <strong class="text-zinc-200">Поділитися</strong> → <strong class="text-zinc-200">На початковий екран</strong>.
        </p>
        <div id="data-stats" class="pt-2 grid grid-cols-2 gap-2.5">
          <div class="rounded-xl bg-zinc-950 p-3 border border-zinc-800/80">
            <div class="text-[11px] text-zinc-400">Виконано підходів</div>
            <div id="stat-logged-sets" class="mt-0.5 text-base font-bold text-emerald-400">0</div>
          </div>
          <div class="rounded-xl bg-zinc-950 p-3 border border-zinc-800/80">
            <div class="text-[11px] text-zinc-400">Загальний тоннаж</div>
            <div id="stat-total-tonnage" class="mt-0.5 text-base font-bold text-amber-400">0 кг</div>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 p-4 space-y-3">
        <h3 class="text-sm font-semibold text-white">Експорт та імпорт (JSON)</h3>
        <div class="flex flex-wrap gap-2">
          <button id="btn-export-download" type="button" class="flex-1 min-w-[140px] rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-emerald-500 active:scale-95">
            Завантажити JSON
          </button>
          <button id="btn-export-copy" type="button" class="flex-1 min-w-[140px] rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2.5 text-xs font-semibold text-zinc-200 transition hover:bg-zinc-700 active:scale-95">
            Скопіювати JSON
          </button>
        </div>

        <div class="pt-2 border-t border-zinc-800 space-y-2">
          <label for="import-json-input" class="block text-xs font-medium text-zinc-400">Встав JSON або обери файл для відновлення:</label>
          <textarea id="import-json-input" rows="3" placeholder='{"logs": ...}' class="w-full rounded-xl border border-zinc-700 bg-zinc-950 p-2.5 text-xs text-zinc-200 placeholder-zinc-600 focus:border-emerald-500 focus:outline-none"></textarea>
          <div class="flex flex-wrap gap-2">
            <button id="btn-import-apply" type="button" class="flex-1 rounded-xl bg-zinc-800 border border-zinc-700 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-zinc-700 active:scale-95">
              Відновити з тексту
            </button>
            <label class="flex-1 cursor-pointer rounded-xl bg-zinc-800 border border-zinc-700 px-4 py-2.5 text-center text-xs font-semibold text-zinc-200 transition hover:bg-zinc-700 active:scale-95">
              Обрати файл .json
              <input id="import-file-input" type="file" accept=".json,application/json" class="hidden" />
            </label>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-red-900/40 bg-red-950/20 p-4 space-y-2.5">
        <h3 class="text-sm font-semibold text-red-400">Очищення даних</h3>
        <div class="flex flex-wrap gap-2">
          <button id="btn-clear-current" type="button" class="flex-1 min-w-[150px] rounded-xl border border-red-800/60 bg-red-950/50 px-3 py-2.5 text-xs font-semibold text-red-300 transition hover:bg-red-900/40 active:scale-95">
            Очистити поточний день
          </button>
          <button id="btn-clear-all" type="button" class="flex-1 min-w-[150px] rounded-xl border border-red-700 bg-red-600/20 px-3 py-2.5 text-xs font-semibold text-red-200 transition hover:bg-red-600/30 active:scale-95">
            Скинути всі 8 тижнів
          </button>
        </div>
      </div>
    </section>

  </main>

  <!-- Floating Rest Timer Bar -->
  <div id="rest-timer-bar" class="fixed bottom-[68px] left-0 right-0 z-30 hidden px-3 safe-bottom">
    <div class="mx-auto flex max-w-2xl items-center justify-between gap-3 rounded-2xl border border-emerald-500/40 bg-zinc-900/95 px-4 py-2.5 shadow-2xl backdrop-blur-md">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-400 font-bold text-sm" id="timer-display">01:30</div>
        <div>
          <div class="text-xs font-semibold text-white">Відпочинок</div>
          <div id="timer-exercise-name" class="text-[11px] text-zinc-400 truncate max-w-[150px] sm:max-w-[240px]"></div>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <button id="btn-timer-add15" type="button" class="rounded-lg border border-zinc-700 bg-zinc-800 px-2.5 py-1.5 text-xs font-semibold text-zinc-200 active:scale-95">+15с</button>
        <button id="btn-timer-toggle" type="button" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white active:scale-95">Пауза</button>
        <button id="btn-timer-stop" type="button" class="rounded-lg border border-zinc-700 bg-zinc-800 px-2.5 py-1.5 text-xs font-semibold text-zinc-400 active:scale-95">✕</button>
      </div>
    </div>
  </div>

  <!-- Bottom Tab Navigation -->
  <nav class="fixed bottom-0 left-0 right-0 z-40 border-t border-zinc-800 bg-zinc-950/95 backdrop-blur-md safe-bottom">
    <div class="mx-auto grid max-w-2xl grid-cols-3">
      <button type="button" data-tab="workout" class="nav-tab flex flex-col items-center justify-center py-2.5 text-xs font-semibold text-emerald-400">
        <svg class="mb-0.5 h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>
        <span>Тренування</span>
      </button>
      <button type="button" data-tab="progress" class="nav-tab flex flex-col items-center justify-center py-2.5 text-xs font-medium text-zinc-400">
        <svg class="mb-0.5 h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>
        <span>Прогрес</span>
      </button>
      <button type="button" data-tab="data" class="nav-tab flex flex-col items-center justify-center py-2.5 text-xs font-medium text-zinc-400">
        <svg class="mb-0.5 h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125"/></svg>
        <span>Дані</span>
      </button>
    </div>
  </nav>

  <!-- In-page Confirmation Modal -->
  <div id="confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 p-4 backdrop-blur-sm">
    <div class="w-full max-w-sm rounded-2xl border border-zinc-800 bg-zinc-900 p-5 shadow-2xl space-y-4">
      <h3 id="confirm-title" class="text-base font-bold text-white">Підтвердження</h3>
      <p id="confirm-message" class="text-sm text-zinc-300"></p>
      <div class="flex justify-end gap-2">
        <button id="confirm-cancel" type="button" class="rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2 text-xs font-semibold text-zinc-200">Скасувати</button>
        <button id="confirm-ok" type="button" class="rounded-xl bg-red-600 px-4 py-2 text-xs font-semibold text-white">Підтвердити</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="pointer-events-none fixed left-1/2 top-16 z-50 -translate-x-1/2 rounded-full border border-zinc-700 bg-zinc-800/95 px-4 py-2 text-xs font-medium text-white opacity-0 shadow-lg transition-opacity duration-200"></div>

  <script>
    const PROGRAM = [
      {
        id: 'w1',
        num: 1,
