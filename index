        duration: 'до 80 хв',
        exercises: [
          { id: 'w1_e1', name: 'Гіперекстензія', rest: 60, note: 'Орієнтир з док: 15×3', weeks: ['3/15','3/15','3/15','3/15','3/15','3/15','3/15','3/15'] },
          { id: 'w1_e2', name: 'Тяга штанги в нахилі', rest: 90, note: 'Орієнтир з док: 5×2', weeks: ['3/10','3/10','3/10','3/10','3/10','*4/10','*4/10','*4/10'] },
          { id: 'w1_e3', name: 'Важільна тяга', rest: 90, note: 'Орієнтир з док: 15×2', weeks: ['3/10','3/10','3/10','3/10','3/10','*4/10','*4/10','*4/10'] },
          { id: 'w1_e4', name: 'Вертикальна тяга в хамері', rest: 90, note: 'Орієнтир з док: 15×2', weeks: ['3/10','3/10','3/10','3/10','3/10','4/10','4/10','4/10'] },
          { id: 'w1_e5', name: 'Жим штанги горизонтальна лавка', rest: 90, note: 'Орієнтир з док: 5×2', weeks: ['3/10','3/10','3/10','3/10','3/10','4/10','4/10','4/10'] },
          { id: 'w1_e6', name: 'Жим гантелей горизонтальна лавка', rest: 90, note: '', weeks: ['3/10','3/10','3/10','3/10','3/10','4/10','4/10','4/10'] },
          { id: 'w1_e7', name: 'Брус’я в хамері', rest: 90, note: '', weeks: ['3/10','3/10','3/10','3/10','3/10','4/10','4/10','4/10'] }
