          { id: 'w3_e2', name: 'Згинання рук сидячи з гантелями', rest: 90, note: 'Орієнтир з док: 7.5 кг', weeks: ['3/10','3/10','3/10','3/10','4/10','4/10','4/10','4/10'] },
          { id: 'w3_e3', name: 'Лавка Скотта', rest: 90, note: 'Орієнтир з док: 5 кг', weeks: ['3/10','3/10','3/10','3/10','4/10','4/10','4/10','4/10'] },
