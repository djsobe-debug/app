    let state = {
      week: 1,
      workoutId: 'w1',
      activeTab: 'workout',
      autoTimer: true,
      expandedGuides: {},
      logs: {} // key: `${week}_${exerciseId}` -> Array<{ isWarmup: boolean, weight: string, reps: string, done: boolean }>
    };

    let timer = {
      remaining: 0,
      running: false,
      intervalId: null,
      exerciseName: ''
    };

    let progressChart = null;
    let confirmCallback = null;

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && typeof parsed === 'object') {
            state.week = Number(parsed.week) >= 1 && Number(parsed.week) <= 8 ? Number(parsed.week) : 1;
            state.workoutId = PROGRAM.some(w => w.id === parsed.workoutId) ? parsed.workoutId : 'w1';
            state.autoTimer = typeof parsed.autoTimer === 'boolean' ? parsed.autoTimer : true;
            state.logs = parsed.logs && typeof parsed.logs === 'object' ? parsed.logs : {};
          }
        }
      } catch (e) {
        // Fallback to in-memory state
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          week: state.week,
          workoutId: state.workoutId,
          autoTimer: state.autoTimer,
          logs: state.logs
        }));
      } catch (e) {
        // Ignore storage quota or sandbox errors
      }
    }

    function parseTarget(spec) {
      const hasWarmup = spec.startsWith('*');
      const clean = spec.replace('*', '');
      const parts = clean.split('/');
      return {
        hasWarmup,
        sets: parseInt(parts[0], 10) || 3,
        reps: parseInt(parts[1], 10) || 10,
        raw: spec
      };
    }

    function getLogKey(week, exerciseId) {
      return `${week}_${exerciseId}`;
    }

    function getOrInitSets(week, exercise) {
      const key = getLogKey(week, exercise.id);
      if (state.logs[key] && Array.isArray(state.logs[key]) && state.logs[key].length > 0) {
        return state.logs[key];
      }
      const target = parseTarget(exercise.weeks[week - 1]);
      const sets = [];
      if (target.hasWarmup) {
        sets.push({ isWarmup: true, weight: '', reps: String(target.reps), done: false });
      }
      for (let i = 0; i < target.sets; i++) {
        sets.push({ isWarmup: false, weight: '', reps: String(target.reps), done: false });
      }
      state.logs[key] = sets;
      return sets;
    }

    function getPrevWeekSummary(week, exerciseId) {
      if (week <= 1) return null;
      const prevKey = getLogKey(week - 1, exerciseId);
      const prevSets = state.logs[prevKey];
      if (!prevSets || !Array.isArray(prevSets)) return null;
      const filled = prevSets.filter(s => !s.isWarmup && (s.weight !== '' || s.done));
      if (filled.length === 0) return null;
      const maxW = Math.max(...filled.map(s => parseFloat(s.weight) || 0));
      const sampleReps = filled[0].reps || '-';
      if (maxW <= 0) return null;
      return `Т${week - 1}: ${maxW} кг × ${sampleReps}`;
    }

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.remove('opacity-0');
      el.classList.add('opacity-100');
      clearTimeout(el._hideTimeout);
      el._hideTimeout = setTimeout(() => {
        el.classList.remove('opacity-100');
        el.classList.add('opacity-0');
      }, 2200);
    }

    function openConfirm(title, message, onOk) {
      document.getElementById('confirm-title').textContent = title;
      document.getElementById('confirm-message').textContent = message;
      confirmCallback = onOk;
      const modal = document.getElementById('confirm-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeConfirm() {
      const modal = document.getElementById('confirm-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      confirmCallback = null;
    }

    function playBeep() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.4);
      } catch (e) {}
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function renderTimerBar() {
      const bar = document.getElementById('rest-timer-bar');
      if (timer.remaining <= 0 && !timer.running) {
        bar.classList.add('hidden');
        return;
      }
      bar.classList.remove('hidden');
      document.getElementById('timer-display').textContent = formatTime(timer.remaining);
      document.getElementById('timer-exercise-name').textContent = timer.exerciseName;
      document.getElementById('btn-timer-toggle').textContent = timer.running ? 'Пауза' : 'Старт';
    }

    function startTimer(seconds, exerciseName) {
      clearInterval(timer.intervalId);
      timer.remaining = seconds;
      timer.running = true;
      timer.exerciseName = exerciseName;
      renderTimerBar();
      timer.intervalId = setInterval(() => {
        if (!timer.running) return;
        timer.remaining -= 1;
        if (timer.remaining <= 0) {
          clearInterval(timer.intervalId);
          timer.running = false;
          timer.remaining = 0;
          playBeep();
          if (navigator.vibrate) {
            try { navigator.vibrate([200, 100, 200]); } catch (e) {}
          }
          showToast('Час відпочинку вийшов! Наступний підхід');
        }
        renderTimerBar();
      }, 1000);
    }

    function renderHeader() {
      const workout = PROGRAM.find(w => w.id === state.workoutId) || PROGRAM[0];
      document.getElementById('header-subtitle').textContent = `Тиждень ${state.week} • Тренування №${workout.num} (${workout.title})`;

      let doneExercises = 0;
      workout.exercises.forEach(ex => {
        const sets = getOrInitSets(state.week, ex);
        const working = sets.filter(s => !s.isWarmup);
        if (working.length > 0 && working.every(s => s.done)) {
          doneExercises += 1;
        }
      });

      const totalEx = workout.exercises.length;
      const pct = totalEx > 0 ? Math.round((doneExercises / totalEx) * 100) : 0;
      document.getElementById('workout-progress-badge').textContent = `${doneExercises}/${totalEx}`;
      document.getElementById('workout-progress-bar').style.width = `${pct}%`;

      const dot = document.getElementById('auto-timer-dot');
      const btn = document.getElementById('btn-auto-timer');
      if (state.autoTimer) {
        dot.className = 'h-2 w-2 rounded-full bg-emerald-400';
        btn.classList.add('border-emerald-500/40', 'text-emerald-300');
        btn.classList.remove('border-zinc-700', 'text-zinc-400');
      } else {
        dot.className = 'h-2 w-2 rounded-full bg-zinc-500';
        btn.classList.remove('border-emerald-500/40', 'text-emerald-300');
        btn.classList.add('border-zinc-700', 'text-zinc-400');
      }
    }

    function renderPills() {
      const weekContainer = document.getElementById('week-pills');
      weekContainer.innerHTML = '';
      for (let w = 1; w <= 8; w++) {
        const active = w === state.week;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.week = String(w);
        btn.className = active
          ? 'shrink-0 rounded-xl bg-emerald-500 px-3.5 py-2 text-xs font-bold text-zinc-950 shadow-sm transition active:scale-95'
          : 'shrink-0 rounded-xl border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs font-medium text-zinc-300 transition hover:bg-zinc-800 active:scale-95';
        btn.textContent = `Тиждень ${w}`;
        weekContainer.appendChild(btn);
      }

      const workoutContainer = document.getElementById('workout-pills');
      workoutContainer.innerHTML = '';
      PROGRAM.forEach(wk => {
        const active = wk.id === state.workoutId;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.workout = wk.id;
        btn.className = active
          ? 'shrink-0 rounded-xl bg-zinc-100 px-3.5 py-2 text-xs font-bold text-zinc-950 shadow-sm transition active:scale-95'
          : 'shrink-0 rounded-xl border border-zinc-800 bg-zinc-900 px-3.5 py-2 text-xs font-medium text-zinc-300 transition hover:bg-zinc-800 active:scale-95';
        btn.textContent = `№${wk.num} ${wk.title}`;
        workoutContainer.appendChild(btn);
      });
    }

    function renderWorkoutView() {
      renderHeader();
      renderPills();

      const workout = PROGRAM.find(w => w.id === state.workoutId) || PROGRAM[0];
      document.getElementById('active-workout-title').textContent = `Тренування №${workout.num}. ${workout.title}`;
      document.getElementById('active-workout-meta').textContent = `Тиждень ${state.week} • ${workout.exercises.length} вправ • ${workout.duration}`;

      const copyPrevBtn = document.getElementById('btn-quick-copy-prev');
      if (state.week === 1) {
        copyPrevBtn.classList.add('hidden');
      } else {
        copyPrevBtn.classList.remove('hidden');
      }

      const list = document.getElementById('exercise-list');
      list.innerHTML = '';

      workout.exercises.forEach((ex, idx) => {
        const target = parseTarget(ex.weeks[state.week - 1]);
        const sets = getOrInitSets(state.week, ex);
        const prevSummary = getPrevWeekSummary(state.week, ex.id);
        const workingDone = sets.filter(s => !s.isWarmup && s.done).length;
        const workingTotal = sets.filter(s => !s.isWarmup).length;
        const allDone = workingTotal > 0 && workingDone === workingTotal;

        const card = document.createElement('div');
        card.className = `rounded-2xl border p-3.5 transition ${allDone ? 'border-emerald-500/40 bg-emerald-950/15' : 'border-zinc-800 bg-zinc-900/70'}`;

        let metaBadges = `<span class="rounded-lg bg-zinc-800 px-2 py-0.5 text-[11px] font-semibold text-zinc-200">${target.sets} підх × ${target.reps} повт</span>`;
        if (target.hasWarmup) {
          metaBadges += `<span class="rounded-lg bg-amber-500/15 border border-amber-500/30 px-2 py-0.5 text-[11px] font-semibold text-amber-300">* Розминка</span>`;
        }
        if (prevSummary) {
          metaBadges += `<span class="rounded-lg bg-sky-500/15 border border-sky-500/30 px-2 py-0.5 text-[11px] font-medium text-sky-300">${prevSummary}</span>`;
        }

        let setsHtml = '';
        let workCounter = 0;
        sets.forEach((s, sIdx) => {
          const label = s.isWarmup ? 'Р' : String(++workCounter);
          const labelClass = s.isWarmup
            ? 'bg-amber-500/20 text-amber-300 border-amber-500/30'
            : (s.done ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' : 'bg-zinc-800 text-zinc-300 border-zinc-700');

          setsHtml += `
            <div class="grid grid-cols-[32px_1fr_76px_44px] items-center gap-2 py-1">
              <div class="flex h-9 w-8 items-center justify-center rounded-lg border text-xs font-bold ${labelClass}">${label}</div>
              <div class="flex items-center rounded-xl border border-zinc-700/80 bg-zinc-950 px-1">
                <button type="button" data-action="step-weight" data-ex="${ex.id}" data-idx="${sIdx}" data-delta="-2.5" class="flex h-10 w-8 items-center justify-center text-sm font-bold text-zinc-400 active:text-white">−</button>
                <input type="number" inputmode="decimal" step="0.5" placeholder="кг" value="${s.weight}" data-action="input-weight" data-ex="${ex.id}" data-idx="${sIdx}" class="h-10 w-full min-w-0 bg-transparent text-center text-sm font-semibold text-white placeholder-zinc-600 focus:outline-none" />
                <button type="button" data-action="step-weight" data-ex="${ex.id}" data-idx="${sIdx}" data-delta="2.5" class="flex h-10 w-8 items-center justify-center text-sm font-bold text-zinc-400 active:text-white">+</button>
              </div>
              <div class="flex items-center rounded-xl border border-zinc-700/80 bg-zinc-950 px-1.5">
                <input type="number" inputmode="numeric" placeholder="${target.reps}" value="${s.reps}" data-action="input-reps" data-ex="${ex.id}" data-idx="${sIdx}" class="h-10 w-full bg-transparent text-center text-sm font-semibold text-white placeholder-zinc-600 focus:outline-none" />
              </div>
              <button type="button" data-action="toggle-done" data-ex="${ex.id}" data-idx="${sIdx}" data-rest="${ex.rest}" data-name="${ex.name}" class="flex h-10 w-11 items-center justify-center rounded-xl border transition active:scale-95 ${s.done ? 'border-emerald-500 bg-emerald-500 text-zinc-950 font-bold' : 'border-zinc-700 bg-zinc-800 text-zinc-400 hover:text-white'}">
                ✓
              </button>
            </div>
          `;
        });

        card.innerHTML = `
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-zinc-500">${idx + 1}.</span>
                <h3 class="text-sm font-bold text-white leading-snug sm:text-base">${ex.name}</h3>
              </div>
              ${ex.note ? `<p class="mt-0.5 text-[11px] text-zinc-400">${ex.note}</p>` : ''}
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" data-action="toggle-guide" data-ex="${ex.id}" class="flex items-center gap-1 rounded-xl border ${state.expandedGuides[ex.id] ? 'border-emerald-500/50 bg-emerald-500/15 text-emerald-300' : 'border-zinc-700 bg-zinc-800/80 text-zinc-300'} px-2.5 py-1.5 text-xs font-semibold transition active:scale-95">
                <span>Техніка</span>
              </button>
              <button type="button" data-action="start-rest" data-rest="${ex.rest}" data-name="${ex.name}" class="flex items-center gap-1 rounded-xl border border-zinc-700 bg-zinc-800/80 px-2.5 py-1.5 text-xs font-semibold text-zinc-200 transition active:scale-95">
                <span>⏱</span>
                <span>${ex.rest}с</span>
              </button>
            </div>
          </div>

          <div class="mt-2 flex flex-wrap gap-1.5">${metaBadges}</div>
          ${(() => {
            if (!state.expandedGuides[ex.id]) return '';
            const g = GUIDE_DATA[ex.id];
            if (!g) return '';
            return `
              <div class="mt-3 rounded-xl border border-zinc-800 bg-zinc-950/80 p-3 space-y-2.5">
                <div class="relative flex justify-center overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900">
                  <img src="${g.img}" data-thumb="${g.thumb}" data-svg="${g.svg}" alt="${ex.name}" class="max-h-56 w-full object-contain bg-zinc-950" loading="lazy" />
                </div>
                <div class="space-y-1 text-xs leading-relaxed">
                  <div><span class="font-semibold text-amber-400">Тренажер:</span> <span class="text-zinc-200">${g.eq}</span></div>
                  <div><span class="font-semibold text-emerald-400">Напрямок руху:</span> <span class="text-zinc-200">${g.dir}</span></div>
                  <div class="text-zinc-400">${g.tech}</div>
                </div>
              </div>
            `;
          })()}

          <div class="mt-3">
            <div class="grid grid-cols-[32px_1fr_76px_44px] gap-2 pb-1 text-[10px] font-semibold uppercase tracking-wider text-zinc-500 text-center">
              <span>Підх</span>
              <span>Вага (кг)</span>
              <span>Повт</span>
              <span>Готово</span>
            </div>
            ${setsHtml}
          </div>

          <div class="mt-2 flex items-center justify-between pt-1">
            <button type="button" data-action="add-set" data-ex="${ex.id}" class="rounded-lg px-2.5 py-1.5 text-xs font-medium text-emerald-400 hover:bg-emerald-500/10 active:scale-95">
              + Додати підхід
            </button>
            ${sets.length > (target.sets + (target.hasWarmup ? 1 : 0)) ? `
              <button type="button" data-action="remove-set" data-ex="${ex.id}" class="rounded-lg px-2.5 py-1.5 text-xs font-medium text-zinc-400 hover:text-red-400 active:scale-95">
                − Видалити останній
              </button>
            ` : ''}
          </div>
        `;

        list.appendChild(card);
      });
    }

    function renderProgressView() {
      const wkSelect = document.getElementById('progress-workout-select');
      const exSelect = document.getElementById('progress-exercise-select');

      if (wkSelect.options.length === 0) {
        PROGRAM.forEach(wk => {
          const opt = document.createElement('option');
          opt.value = wk.id;
          opt.textContent = `№${wk.num} ${wk.title}`;
          wkSelect.appendChild(opt);
        });
        wkSelect.value = state.workoutId;
      }

      const selectedWk = PROGRAM.find(w => w.id === wkSelect.value) || PROGRAM[0];
      const currentExVal = exSelect.value;
      exSelect.innerHTML = '';
      selectedWk.exercises.forEach(ex => {
        const opt = document.createElement('option');
        opt.value = ex.id;
        opt.textContent = ex.name;
        exSelect.appendChild(opt);
      });
      if (selectedWk.exercises.some(e => e.id === currentExVal)) {
        exSelect.value = currentExVal;
      }

      const exercise = selectedWk.exercises.find(e => e.id === exSelect.value) || selectedWk.exercises[0];
      document.getElementById('chart-exercise-label').textContent = exercise.name;

      const labels = [];
      const maxWeights = [];
      let overallMaxW = 0;
      let overallMaxVol = 0;
      let totalDoneSets = 0;

      for (let w = 1; w <= 8; w++) {
        labels.push(`Т${w}`);
        const sets = state.logs[getLogKey(w, exercise.id)] || [];
        const workSets = sets.filter(s => !s.isWarmup);
        let wkMaxW = 0;
        let wkVol = 0;
        workSets.forEach(s => {
          const kg = parseFloat(s.weight) || 0;
          const rp = parseInt(s.reps, 10) || 0;
          if (kg > wkMaxW) wkMaxW = kg;
          if (kg > 0 && rp > 0) wkVol += kg * rp;
          if (s.done) totalDoneSets += 1;
        });
        if (wkMaxW > overallMaxW) overallMaxW = wkMaxW;
        if (wkVol > overallMaxVol) overallMaxVol = wkVol;
        maxWeights.push(wkMaxW > 0 ? wkMaxW : null);
      }

      document.getElementById('kpi-max-weight').textContent = `${overallMaxW} кг`;
      document.getElementById('kpi-max-volume').textContent = `${Math.round(overallMaxVol)} кг`;
      document.getElementById('kpi-total-sets').textContent = String(totalDoneSets);

      const ctx = document.getElementById('progress-chart').getContext('2d');
      if (progressChart) {
        progressChart.destroy();
      }
      progressChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Макс. вага (кг)',
            data: maxWeights,
            borderColor: '#10b981',
            backgroundColor: 'rgba(16, 185, 129, 0.15)',
            borderWidth: 2.5,
            pointBackgroundColor: '#10b981',
            pointRadius: 4,
            tension: 0.3,
            fill: true,
            spanGaps: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: {
              grid: { color: 'rgba(63, 63, 70, 0.3)' },
              ticks: { color: '#a1a1aa', font: { size: 11 } }
            },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(63, 63, 70, 0.3)' },
              ticks: { color: '#a1a1aa', font: { size: 11 } }
            }
          }
        }
      });
    }

    function renderDataView() {
      let totalSets = 0;
      let totalTonnage = 0;
      Object.values(state.logs).forEach(sets => {
        if (!Array.isArray(sets)) return;
        sets.forEach(s => {
          if (s.done) totalSets += 1;
          const kg = parseFloat(s.weight) || 0;
          const rp = parseInt(s.reps, 10) || 0;
          if (!s.isWarmup && s.done && kg > 0 && rp > 0) {
            totalTonnage += kg * rp;
          }
        });
      });
      document.getElementById('stat-logged-sets').textContent = String(totalSets);
      document.getElementById('stat-total-tonnage').textContent = `${Math.round(totalTonnage)} кг`;
    }

    function switchTab(tab) {
      state.activeTab = tab;
      document.getElementById('view-workout').classList.toggle('hidden', tab !== 'workout');
      document.getElementById('view-progress').classList.toggle('hidden', tab !== 'progress');
      document.getElementById('view-data').classList.toggle('hidden', tab !== 'data');

      document.querySelectorAll('.nav-tab').forEach(btn => {
        const isCurrent = btn.dataset.tab === tab;
        btn.classList.toggle('text-emerald-400', isCurrent);
        btn.classList.toggle('font-semibold', isCurrent);
        btn.classList.toggle('text-zinc-400', !isCurrent);
        btn.classList.toggle('font-medium', !isCurrent);
      });

      if (tab === 'workout') renderWorkoutView();
      if (tab === 'progress') renderProgressView();
      if (tab === 'data') renderDataView();
    }

    function setupEvents() {
      document.getElementById('week-pills').addEventListener('click', e => {
        const btn = e.target.closest('button[data-week]');
        if (!btn) return;
        state.week = Number(btn.dataset.week);
        saveState();
        renderWorkoutView();
      });

      document.getElementById('workout-pills').addEventListener('click', e => {
        const btn = e.target.closest('button[data-workout]');
        if (!btn) return;
        state.workoutId = btn.dataset.workout;
        saveState();
        renderWorkoutView();
      });

      document.getElementById('btn-auto-timer').addEventListener('click', () => {
        state.autoTimer = !state.autoTimer;
        saveState();
        renderHeader();
        showToast(state.autoTimer ? 'Автотаймер увімкнено' : 'Автотаймер вимкнено');
      });

      document.getElementById('btn-quick-copy-prev').addEventListener('click', () => {
        if (state.week <= 1) return;
        const workout = PROGRAM.find(w => w.id === state.workoutId);
        let copiedCount = 0;
        workout.exercises.forEach(ex => {
          const prevSets = state.logs[getLogKey(state.week - 1, ex.id)];
          if (!prevSets || prevSets.length === 0) return;
          const currSets = getOrInitSets(state.week, ex);
          currSets.forEach((cs, idx) => {
            if (cs.weight === '' && prevSets[idx] && prevSets[idx].weight !== '') {
              cs.weight = prevSets[idx].weight;
              copiedCount += 1;
            }
          });
        });
        saveState();
        renderWorkoutView();
        showToast(copiedCount > 0 ? `Підтягнуто вагу з Тижня ${state.week - 1}` : 'Немає збереженої ваги за минулий тиждень');
      });

      const exList = document.getElementById('exercise-list');

      exList.addEventListener('error', e => {
        const img = e.target;
        if (!img || img.tagName !== 'IMG') return;
        const thumb = img.getAttribute('data-thumb');
        if (thumb && img.src !== thumb && !img.dataset.triedThumb) {
          img.dataset.triedThumb = '1';
          img.src = thumb;
          return;
        }
        const svgType = img.getAttribute('data-svg');
        if (svgType && img.parentElement) {
          img.parentElement.innerHTML = renderExerciseSvg(svgType);
        }
      }, true);

      exList.addEventListener('click', e => {
        const btn = e.target.closest('button[data-action]');
        if (!btn) return;
        const action = btn.dataset.action;
        const exId = btn.dataset.ex;
        const idx = Number(btn.dataset.idx);
        const workout = PROGRAM.find(w => w.id === state.workoutId);
        const exercise = workout ? workout.exercises.find(x => x.id === exId) : null;

        if (action === 'toggle-guide') {
          state.expandedGuides[exId] = !state.expandedGuides[exId];
          renderWorkoutView();
          return;
        }
        if (action === 'start-rest') {
          startTimer(Number(btn.dataset.rest) || 90, btn.dataset.name || '');
          return;
        }
        if (!exercise) return;
        const sets = getOrInitSets(state.week, exercise);

        if (action === 'step-weight') {
          const delta = parseFloat(btn.dataset.delta);
          const current = parseFloat(sets[idx].weight) || 0;
          const next = Math.max(0, Math.round((current + delta) * 10) / 10);
          sets[idx].weight = next === 0 ? '' : String(next);
          saveState();
          renderWorkoutView();
        } else if (action === 'toggle-done') {
          sets[idx].done = !sets[idx].done;
          saveState();
          renderWorkoutView();
          if (sets[idx].done && state.autoTimer) {
            startTimer(Number(btn.dataset.rest) || 90, btn.dataset.name || exercise.name);
          }
        } else if (action === 'add-set') {
          const target = parseTarget(exercise.weeks[state.week - 1]);
          const lastWork = [...sets].reverse().find(s => !s.isWarmup);
          sets.push({
            isWarmup: false,
            weight: lastWork ? lastWork.weight : '',
            reps: lastWork ? lastWork.reps : String(target.reps),
            done: false
          });
          saveState();
          renderWorkoutView();
        } else if (action === 'remove-set') {
          if (sets.length > 1) {
            sets.pop();
            saveState();
            renderWorkoutView();
          }
        }
      });

      exList.addEventListener('input', e => {
        const inp = e.target.closest('input[data-action]');
        if (!inp) return;
        const action = inp.dataset.action;
        const exId = inp.dataset.ex;
        const idx = Number(inp.dataset.idx);
        const workout = PROGRAM.find(w => w.id === state.workoutId);
        const exercise = workout ? workout.exercises.find(x => x.id === exId) : null;
        if (!exercise) return;
        const sets = getOrInitSets(state.week, exercise);
        if (!sets[idx]) return;

        if (action === 'input-weight') {
          sets[idx].weight = inp.value;
          saveState();
        } else if (action === 'input-reps') {
          sets[idx].reps = inp.value;
          saveState();
        }
      });

      // Timer controls
      document.getElementById('btn-timer-add15').addEventListener('click', () => {
        timer.remaining += 15;
        renderTimerBar();
      });
      document.getElementById('btn-timer-toggle').addEventListener('click', () => {
        timer.running = !timer.running;
        renderTimerBar();
      });
      document.getElementById('btn-timer-stop').addEventListener('click', () => {
        clearInterval(timer.intervalId);
        timer.running = false;
        timer.remaining = 0;
        renderTimerBar();
      });

      // Bottom tabs
      document.querySelectorAll('.nav-tab').forEach(btn => {
        btn.addEventListener('click', () => switchTab(btn.dataset.tab));
      });

      // Progress selectors
      document.getElementById('progress-workout-select').addEventListener('change', renderProgressView);
      document.getElementById('progress-exercise-select').addEventListener('change', renderProgressView);

      // Data / Backup actions
      document.getElementById('btn-export-download').addEventListener('click', () => {
        const blob = new Blob([JSON.stringify({ logs: state.logs, exportedAt: new Date().toISOString() }, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `gym_backup_w${state.week}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        showToast('Файл резервної копії завантажено');
      });

      document.getElementById('btn-export-copy').addEventListener('click', () => {
        const text = JSON.stringify({ logs: state.logs });
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(() => showToast('JSON скопійовано')).catch(() => fallbackCopy(text));
        } else {
          fallbackCopy(text);
        }
      });

      function fallbackCopy(text) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          showToast('JSON скопійовано');
        } catch (e) {
          showToast('Не вдалося скопіювати');
        }
        ta.remove();
      }

      document.getElementById('btn-import-apply').addEventListener('click', () => {
        const raw = document.getElementById('import-json-input').value.trim();
        if (!raw) {
          showToast('Вставте JSON-дані');
          return;
        }
        try {
          const parsed = JSON.parse(raw);
          const logs = parsed.logs || parsed;
          if (typeof logs !== 'object' || Array.isArray(logs)) throw new Error('Invalid');
          state.logs = logs;
          saveState();
          renderDataView();
          showToast('Дані успішно відновлено!');
        } catch (e) {
          showToast('Помилка: некоректний формат JSON');
        }
      });

      document.getElementById('import-file-input').addEventListener('change', e => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          document.getElementById('import-json-input').value = ev.target.result;
          document.getElementById('btn-import-apply').click();
        };
        reader.readAsText(file);
      });

      document.getElementById('btn-clear-current').addEventListener('click', () => {
        openConfirm('Очистити поточне тренування?', `Видалити всі введені підходи для Тижня ${state.week} (Тренування ${state.workoutId.toUpperCase()})?`, () => {
          const workout = PROGRAM.find(w => w.id === state.workoutId);
          workout.exercises.forEach(ex => {
            delete state.logs[getLogKey(state.week, ex.id)];
          });
          saveState();
          renderDataView();
          showToast('Поточне тренування очищено');
        });
      });

      document.getElementById('btn-clear-all').addEventListener('click', () => {
        openConfirm('Скинути всі 8 тижнів?', 'Це назавжди видалить усі збережені ваги та повторення за весь цикл.', () => {
          state.logs = {};
          saveState();
          renderDataView();
          showToast('Усі дані скинуто');
        });
      });

      document.getElementById('confirm-cancel').addEventListener('click', closeConfirm);
      document.getElementById('confirm-ok').addEventListener('click', () => {
        if (confirmCallback) confirmCallback();
        closeConfirm();
      });
    }

    loadState();
    setupEvents();
    renderWorkoutView();
  </script>
</body>
</html>